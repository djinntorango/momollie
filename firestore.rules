rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /promotions/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /orders/{id} {
      allow read, write: if request.auth != null;
      // Webhook writes via admin SDK bypass rules
    }
    match /settings/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
